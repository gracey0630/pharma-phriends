# Copy to .env and fill in. .env is gitignored; never commit keys.

# openFDA: optional, raises the rate limit (free key: https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Google Gemini: used by the Label Research Agent (extraction) and the finder's summary cards.
# Optional: without a key, analog_finder falls back to FakeLLM / template cards and still runs.
# (key from https://aistudio.google.com/apikey; the google-genai SDK reads GEMINI_API_KEY)
GEMINI_API_KEY=
# Gemini model id; check it against current Google docs when setting up
GEMINI_MODEL=

# SEC EDGAR requires a descriptive User-Agent with contact info, e.g. "Pharma Phriends research yourname@school.edu"
# Use your own; never commit it.
SEC_USER_AGENT=
