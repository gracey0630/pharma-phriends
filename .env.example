# Copy to .env and fill in. .env is gitignored; never commit keys.

# openFDA: optional, raises the rate limit (free key: https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Google Gemini: needed for evidence extraction (workstream C) and the analog agent (D)
# (key from https://aistudio.google.com/apikey; the google-genai SDK reads GEMINI_API_KEY)
GEMINI_API_KEY=
